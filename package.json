{
  "name": "auto-friend",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "@types/bun": "^1.4.2",
      "varlock": "1.18.0",
      "libsql": "0.5.29",
      "@trpc/server": "^11.18.0",
      "better-auth": "1.7.7",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "@trpc/tanstack-react-query": "^11.18.0",
      "@trpc/client": "^11.18.0",
      "@tanstack/react-query": "^5.102.8",
      "@tanstack/react-form": "^1.33.5",
      "@types/node": "^26.4.1",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3",
      "@better-auth/expo": "1.7.7",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @auto-friend/db --",
    "db:studio": "turbo run db:studio -F @auto-friend/db --",
    "db:generate": "turbo run db:generate -F @auto-friend/db --",
    "db:migrate": "turbo run db:migrate -F @auto-friend/db --",
    "db:local": "turbo run db:local -F @auto-friend/db --",
    "db:seed": "turbo run db:seed -F @auto-friend/db --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && bun run auth:generate",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@auto-friend/config": "workspace:*",
    "@types/bun": "catalog:",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.3.11"
}
